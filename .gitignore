.env
.env.*
!.env.example
*.pem
*.key

# ────────────────────────────────────────────────
#  Database / ORM local artifacts
# ────────────────────────────────────────────────
drizzle/
.neon/
*.sqlite
*.db

# ────────────────────────────────────────────────
#  Logs & OS
# ────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# ────────────────────────────────────────────────
#  Editors & IDEs
# ────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ────────────────────────────────────────────────
#  AI / agent tooling (keep shared skills, ignore personal state)
