# ────────────────────────────────────────────────────────────────
#  Body D — environment variables
#  Copy to `.env.local` for local dev, or set these in your host
#  (Vercel/Neon/Clerk) for production. Only DATABASE_URL is required.
# ────────────────────────────────────────────────────────────────

# Required — Neon Serverless Postgres connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional — Clerk authentication (omit to run as a single local user)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional — AI coach. The coach prefers Inception; Gemini/Groq/Neon
# AI Gateway are fallbacks. Set at least one.
INCEPTION_API_KEY=...
# INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
# INCEPTION_MODEL=mercury-3

GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=...
# GROQ_MODEL=openai/gpt-oss-120b

# Optional — Neon AI Gateway (alternative provider)
# NEON_AI_GATEWAY_TOKEN=...
# NEON_AI_GATEWAY_BASE_URL=...
# NEON_AI_GATEWAY_MODEL=...
